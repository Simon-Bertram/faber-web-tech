---
import { Font } from "astro:assets";
import "../styles/global.css";
import BrandLogo from "../components/BrandLogo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  active?: "admin" | "clients" | "projects" | "access" | "dashboard";
  title?: string;
  variant?: "admin" | "client";
}

const {
  active = "dashboard",
  title = "Portal - Faber Web Tech",
  variant = "client",
} = Astro.props;

const adminLinks = [
  { href: "/admin", id: "admin", label: "Overview" },
  { href: "/admin/clients", id: "clients", label: "Clients" },
  { href: "/admin/projects", id: "projects", label: "Projects" },
  { href: "/admin/access", id: "access", label: "Access" },
] as const;

const clientLinks = [
  { href: "/dashboard", id: "dashboard", label: "My Projects" },
] as const;

const links = variant === "admin" ? adminLinks : clientLinks;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <title>{title}</title>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-hanken-grotesk" />
    <Font cssVariable="--font-encode-sans-expanded" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          const systemTheme = prefersDark ? "dark" : "light";
          const theme =
            stored === "light" || stored === "dark" ? stored : systemTheme;
          if (theme === "dark") {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
          document.documentElement.dataset.theme = theme;
        } catch {
          // Ignore restricted storage environments
        }
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased flex flex-col bg-(--bg-canvas)">
    <header
      class="sticky top-0 z-40 border-b border-(--border-subtle) bg-(--glass-bg) backdrop-blur-md"
    >
      <div
        class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6"
      >
        <div class="flex items-center gap-6">
          <BrandLogo size="sm" />
          <nav aria-label="Portal" class="hidden items-center gap-1 sm:flex">
            {links.map((link) => (
                <a
                  class:list={[
                    "rounded px-2.5 py-1.5 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--primary)",
                    active === link.id
                      ? "text-(--primary)"
                      : "text-(--text-secondary) hover:text-(--text-primary)",
                  ]}
                  href={link.href}
                >
                  {link.label}
                </a>
              ))}
          </nav>
        </div>
        <div class="flex items-center gap-3">
          <span
            class="hidden text-xs font-mono text-(--text-muted) sm:inline"
            id="portal-user-label"
          ></span>
          <ThemeToggle />
          <button
            class="rounded border border-(--border-subtle) bg-(--bg-surface) px-3 py-1.5 text-xs font-medium text-(--text-secondary) transition-colors hover:border-red-500/50 hover:bg-red-500/10 hover:text-red-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500"
            id="portal-signout"
            type="button"
          >
            Sign out
          </button>
        </div>
      </div>
      <nav
        aria-label="Portal mobile"
        class="flex gap-1 overflow-x-auto border-t border-(--border-subtle) px-4 py-2 sm:hidden"
      >
        {links.map((link) => (
            <a
              class:list={[
                "shrink-0 rounded px-2.5 py-1.5 text-xs font-medium",
                active === link.id
                  ? "bg-(--primary-container) text-(--primary)"
                  : "text-(--text-secondary)",
              ]}
              href={link.href}
            >
              {link.label}
            </a>
          ))}
      </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6">
      <slot />
    </main>
  </body>
</html>

<script>
  import { authClient } from "../lib/auth-client";

  const label = document.getElementById("portal-user-label");
  const signOut = document.getElementById("portal-signout");

  async function init() {
    try {
      const { data: session } = await authClient.getSession();
      if (label && session?.user) {
        label.textContent =
          session.user.name || session.user.email?.split("@")[0] || "User";
      }
    } catch {
      // Session already gated by middleware
    }
  }

  signOut?.addEventListener("click", async () => {
    await authClient.signOut({
      fetchOptions: {
        onSuccess: () => {
          window.location.href = "/";
        },
      },
    });
  });

  init();
</script>
