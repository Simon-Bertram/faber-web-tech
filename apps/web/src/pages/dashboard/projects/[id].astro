---
import PortalLayout from "../../../layouts/PortalLayout.astro";

const { id } = Astro.params;
---

<PortalLayout
  active="dashboard"
  title="Project - Faber Web Tech"
  variant="client"
>
  <div class="space-y-8" data-project-id={id}>
    <div>
      <a
        class="text-(--text-muted) text-sm hover:text-(--primary)"
        href="/dashboard"
      >
        ← Back to projects
      </a>
      <h1
        class="mt-3 font-display font-bold text-3xl text-(--text-primary)"
        id="project-name"
      >
        Loading…
      </h1>
      <p class="mt-1 text-(--text-secondary) text-sm" id="project-meta"></p>
    </div>

    <section class="space-y-3">
      <h2 class="font-display font-semibold text-(--text-primary) text-xl">
        Progress
      </h2>
      <div
        class="rounded-xl border border-(--border-subtle) bg-(--bg-surface) p-5"
      >
        <div class="flex flex-wrap gap-4 text-sm">
          <p>
            <span class="text-(--text-muted)">Completed</span>
            <span
              class="ml-2 font-mono text-(--text-primary)"
              id="progress-completed"
              >—</span
            >
          </p>
          <p>
            <span class="text-(--text-muted)">Remaining</span>
            <span
              class="ml-2 font-mono text-(--text-primary)"
              id="progress-pending"
              >—</span
            >
          </p>
        </div>
        <div
          class="mt-4 h-2 overflow-hidden rounded-full bg-(--bg-surface-elevated)"
        >
          <div
            class="h-full rounded-full bg-(--primary) transition-all"
            id="progress-bar"
            style="width: 0%"
          ></div>
        </div>
      </div>
      <ul class="space-y-2" id="milestone-list"></ul>
    </section>

    <section class="space-y-3">
      <h2 class="font-display font-semibold text-(--text-primary) text-xl">
        Requirements & specs
      </h2>
      <div class="space-y-3" id="requirement-list"></div>
    </section>

    <p class="text-(--text-muted) text-sm" id="detail-status"></p>
  </div>
</PortalLayout>

<script>
  import { orpc } from "../../../lib/orpc";

  const root = document.querySelector("[data-project-id]") as HTMLElement;
  const projectId = root.dataset.projectId!;
  const nameEl = document.getElementById("project-name")!;
  const metaEl = document.getElementById("project-meta")!;
  const completedEl = document.getElementById("progress-completed")!;
  const pendingEl = document.getElementById("progress-pending")!;
  const barEl = document.getElementById("progress-bar")!;
  const milestonesEl = document.getElementById("milestone-list")!;
  const requirementsEl = document.getElementById("requirement-list")!;
  const statusEl = document.getElementById("detail-status")!;

  function statusLabel(value: string) {
    return value.replaceAll("_", " ");
  }

  async function init() {
    try {
      const detail = await orpc.client.projects.get({ id: projectId });
      nameEl.textContent = detail.name;
      metaEl.textContent = `${detail.clientName} · ${statusLabel(detail.status)}`;
      completedEl.textContent = String(detail.progress.completed);
      pendingEl.textContent = String(detail.progress.pending);
      const pct =
        detail.progress.total === 0
          ? 0
          : Math.round(
              (detail.progress.completed / detail.progress.total) * 100
            );
      barEl.style.width = `${pct}%`;

      milestonesEl.innerHTML =
        detail.milestones.length === 0
          ? `<li class="text-(--text-muted) text-sm">No milestones yet.</li>`
          : detail.milestones
              .map(
                (item) => `
          <li class="flex items-center justify-between gap-3 rounded-lg border border-(--border-subtle) bg-(--bg-surface) px-4 py-3">
            <span class="text-(--text-primary) text-sm">${item.title}</span>
            <span class="font-mono text-(--text-muted) text-xs uppercase">${statusLabel(item.status)}</span>
          </li>`
              )
              .join("");

      requirementsEl.innerHTML =
        detail.requirements.length === 0
          ? `<p class="text-(--text-muted) text-sm">No requirements published yet.</p>`
          : detail.requirements
              .map(
                (item) => `
          <article class="rounded-xl border border-(--border-subtle) bg-(--bg-surface) p-5">
            <h3 class="font-medium text-(--text-primary)">${item.title}</h3>
            <p class="mt-2 whitespace-pre-wrap text-(--text-secondary) text-sm">${item.body}</p>
          </article>`
              )
              .join("");
    } catch {
      statusEl.textContent = "Unable to load this project.";
      nameEl.textContent = "Project unavailable";
    }
  }

  init();
</script>
