---
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import ServicesOverview from "../components/ServicesOverview.astro";
import TechStackBanner from "../components/TechStackBanner.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  description="High-performance websites, scalable web applications, and custom AI automations engineered to accelerate business growth."
  title="Faber Web Tech | Modern Web Tech to Boost Your Business"
>
  <div class="flex flex-col w-full">
    <!-- Hero Section with Dynamic Services Slideshow -->
    <HeroCarousel />

    <!-- Architecture & Technology Trust Strip -->
    <TechStackBanner />

    <!-- Detailed 3-Tier Services Overview -->
    <ServicesOverview />

    <!-- Lead Conversion Call-to-Action -->
    <CtaBanner />

    <!-- Site Footer & API Health Monitor -->
    <Footer />
  </div>
</Layout>
