---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Faber">
  <section
    class="relative flex min-h-[calc(100vh-3.5rem)] flex-col justify-center overflow-hidden"
  >
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background:
				radial-gradient(ellipse 80% 60% at 15% 20%, rgb(255 92 0 / 0.18), transparent 55%),
				radial-gradient(ellipse 70% 50% at 85% 30%, rgb(108 4 222 / 0.16), transparent 50%),
				radial-gradient(ellipse 50% 40% at 50% 100%, rgb(0 219 233 / 0.08), transparent 60%);"
    >
    </div>

    <div
      class="relative mx-auto w-full max-w-[1280px] px-4 py-20 md:px-16 md:py-28"
    >
      <p
        class="font-display text-on-surface text-5xl font-bold tracking-[-0.02em] md:text-7xl md:leading-[80px]"
      >
        Faber
      </p>
      <h1
        class="font-display text-on-surface mt-4 max-w-3xl text-3xl font-semibold tracking-[-0.01em] md:text-5xl md:leading-[56px]"
      >
        Architects of the future web
      </h1>
      <p class="text-on-surface/75 mt-6 max-w-xl text-lg leading-7">
        High-performance engineering for brands that move fast—technical mastery
        with creative energy.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/signup" class="btn-primary">Start a project</a>
        <a href="/login" class="btn-secondary">Sign in</a>
      </div>
    </div>

    <div
      class="relative mx-auto mt-auto flex w-full max-w-[1280px] items-center gap-2 px-4 pb-6 md:px-16"
    >
      <span id="status-dot" class="bg-outline-variant h-2 w-2 rounded-full"
      ></span>
      <span id="status-text" class="label-caps text-on-surface-variant/60"
        >Connecting…</span
      >
    </div>
  </section>
</Layout>

<script>
  import { orpc } from "../lib/orpc";

  const statusDot = document.getElementById("status-dot")!;
  const statusText = document.getElementById("status-text")!;

  async function checkHealth() {
    try {
      await orpc.healthCheck();
      statusDot.className = "h-2 w-2 rounded-full bg-tertiary";
      statusText.textContent = "Connected";
    } catch (error) {
      statusDot.className = "h-2 w-2 rounded-full bg-error";
      statusText.textContent = "Disconnected";
    }
  }

  checkHealth();
</script>
