---
import Slideshow from "../components/slideshow/slideshow.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Faber">
  <Slideshow />

  <div
    class="relative mx-auto flex w-full max-w-7xl items-center gap-2 px-4 py-6 md:px-16"
  >
    <span class="bg-outline-variant h-2 w-2 rounded-full" id="status-dot"
    ></span>
    <span class="label-caps text-on-surface-variant/60" id="status-text"
      >Connecting…</span
    >
  </div>
</Layout>

<script>
  import { orpc } from "../lib/orpc";

  const statusDot = document.getElementById("status-dot")!;
  const statusText = document.getElementById("status-text")!;

  async function checkHealth() {
    try {
      await orpc.healthCheck();
      statusDot.className = "h-2 w-2 rounded-full bg-tertiary";
      statusText.textContent = "Connected";
    } catch {
      statusDot.className = "h-2 w-2 rounded-full bg-error";
      statusText.textContent = "Disconnected";
    }
  }

  checkHealth();
</script>
