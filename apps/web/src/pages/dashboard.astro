---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dashboard — Faber">
  <div class="hidden" id="dashboard-content">
    <main class="mx-auto max-w-4xl px-4 py-10 md:px-16">
      <div class="glass-panel p-8">
        <h1
          class="font-display text-on-surface mb-8 text-3xl font-semibold tracking-tight"
        >
          Dashboard
        </h1>

        <div class="space-y-4">
          <div
            class="border-border-glass border-t-primary-container bg-surface-container-low/50 rounded border border-t-2 p-4"
          >
            <p class="label-caps text-on-surface-variant">Welcome back</p>
            <p class="text-on-surface mt-1 text-xl font-medium" id="user-name">
              Loading...
            </p>
          </div>

          <div
            class="border-border-glass border-t-secondary-container bg-surface-container-low/50 rounded border border-t-2 p-4"
          >
            <p class="label-caps text-on-surface-variant mb-2">Email</p>
            <p class="text-on-surface" id="user-email">Loading...</p>
          </div>

          <div
            class="border-border-glass border-t-tertiary-container bg-surface-container-low/50 rounded border border-t-2 p-4"
          >
            <p class="label-caps text-on-surface-variant mb-2">
              Server Message
            </p>
            <p class="text-on-surface font-mono text-sm" id="api-message">
              Loading...
            </p>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div
    class="flex h-[calc(100vh-3.5rem)] items-center justify-center"
    id="loading"
  >
    <p class="label-caps text-on-surface-variant">Loading...</p>
  </div>

  <div
    class="hidden h-[calc(100vh-3.5rem)] items-center justify-center"
    id="redirect"
  >
    <p class="label-caps text-on-surface-variant">Redirecting to login...</p>
  </div>
</Layout>

<script>
  import { authClient } from "../lib/auth-client";
  import { orpc } from "../lib/orpc";

  const dashboardContent = document.getElementById("dashboard-content")!;
  const loading = document.getElementById("loading")!;
  const redirect = document.getElementById("redirect")!;
  const userName = document.getElementById("user-name")!;
  const userEmail = document.getElementById("user-email")!;
  const apiMessage = document.getElementById("api-message")!;

  async function init() {
    try {
      const { data: session } = await authClient.getSession();

      if (!session?.user) {
        loading.classList.add("hidden");
        redirect.classList.remove("hidden");
        redirect.classList.add("flex");
        window.location.href = "/login";
        return;
      }

      userName.textContent = session.user.name || "User";
      userEmail.textContent = session.user.email || "";

      try {
        const data = await orpc.privateData();
        apiMessage.textContent = data.message || "Connected to server";
      } catch (e) {
        apiMessage.textContent = "Failed to load server data";
      }

      loading.classList.add("hidden");
      dashboardContent.classList.remove("hidden");
    } catch (error) {
      loading.classList.add("hidden");
      redirect.classList.remove("hidden");
      redirect.classList.add("flex");
      window.location.href = "/login";
    }
  }

  init();
</script>
