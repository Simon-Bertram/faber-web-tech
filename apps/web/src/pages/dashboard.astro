---
import PortalLayout from "../layouts/PortalLayout.astro";
---

<PortalLayout
  active="dashboard"
  title="My Projects - Faber Web Tech"
  variant="client"
>
  <div class="space-y-6">
    <div>
      <p class="font-mono text-(--text-muted) text-xs uppercase tracking-wider">
        Client portal
      </p>
      <h1 class="mt-1 font-display font-bold text-3xl text-(--text-primary)">
        My projects
      </h1>
    </div>

    <div class="hidden" id="pending-state">
      <div
        class="rounded-xl border border-(--border-subtle) bg-(--bg-surface) p-8 text-center"
      >
        <h2 class="font-display font-semibold text-(--text-primary) text-xl">
          Account pending access
        </h2>
        <p class="mx-auto mt-2 max-w-md text-(--text-secondary) text-sm">
          You're signed in. We'll link your account to a project shortly — check
          back once you've heard from us.
        </p>
      </div>
    </div>

    <div class="hidden space-y-3" id="project-list"></div>

    <p class="text-(--text-muted) text-sm" id="dashboard-status">Loading…</p>
  </div>
</PortalLayout>

<script>
  import { orpc } from "../lib/orpc";

  const status = document.getElementById("dashboard-status")!;
  const pending = document.getElementById("pending-state")!;
  const list = document.getElementById("project-list")!;

  function statusLabel(value: string) {
    return value.replaceAll("_", " ");
  }

  async function init() {
    try {
      const projects = await orpc.client.projects.list();
      status.classList.add("hidden");

      if (projects.length === 0) {
        pending.classList.remove("hidden");
        return;
      }

      list.classList.remove("hidden");
      list.innerHTML = projects
        .map(
          (project) => `
        <a
          class="block rounded-xl border border-(--border-subtle) bg-(--bg-surface) p-5 transition-colors hover:border-(--border-hover)"
          href="/dashboard/projects/${project.id}"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="font-display font-semibold text-(--text-primary) text-lg">${project.name}</h2>
              <p class="mt-1 text-(--text-muted) text-sm">${project.clientName}</p>
            </div>
            <span class="rounded border border-(--border-subtle) px-2 py-0.5 font-mono text-(--text-secondary) text-xs uppercase">${statusLabel(project.status)}</span>
          </div>
        </a>`
        )
        .join("");
    } catch {
      status.textContent = "Failed to load projects. Please refresh.";
    }
  }

  init();
</script>
