---
// TechStackBanner.astro - Trust & High-Performance Architecture Strip
const technologies = [
  { name: "Astro", role: "Edge-First Islands & SSG" },
  { name: "Cloudflare Workers", role: "Global Edge Runtime" },
  { name: "Hono", role: "Ultrafast Edge API" },
  { name: "oRPC", role: "End-to-End Type Safety" },
  { name: "Drizzle D1", role: "Serverless SQL" },
  { name: "Better-Auth", role: "Hardened Security" },
];
---

<section
  class="border-b border-(--border-subtle) bg-(--bg-surface) py-8 transition-colors"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-6"
    >
      <div class="max-w-xs">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-widest text-(--primary)"
        >
          Architectural Standard
        </span>
        <p class="text-sm font-medium text-(--text-secondary) mt-1">
          Engineered on zero-bloat, edge-native foundational technologies.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 flex-1">
        {technologies.map((tech) => (
          <div class="group rounded border border-(--border-subtle) bg-(--bg-canvas) p-3 text-center transition-all hover:border-(--border-hover) hover:bg-(--bg-surface-elevated)">
            <div class="font-bold font-mono text-(--text-primary) text-xs transition-colors group-hover:text-(--primary)">
              {tech.name}
            </div>
            <div class="mt-0.5 text-(--text-muted) text-[11px] leading-tight">
              {tech.role}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
