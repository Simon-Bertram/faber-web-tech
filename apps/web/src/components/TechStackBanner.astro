---
import AstroIcon from "../assets/tech-icons/astro.svg";
import BetterAuthIcon from "../assets/tech-icons/better-auth.svg";
import CloudflareIcon from "../assets/tech-icons/cloudflare.svg";
import HonoIcon from "../assets/tech-icons/hono.svg";
import OrpcIcon from "../assets/tech-icons/orpc.svg";
import ReactIcon from "../assets/tech-icons/react.svg";
import TailwindIcon from "../assets/tech-icons/tailwindcss.svg";
import { technologies } from "../data/tech-stack";

const icons = {
  astro: AstroIcon,
  "better-auth": BetterAuthIcon,
  "cloudflare-workers": CloudflareIcon,
  hono: HonoIcon,
  orpc: OrpcIcon,
  react: ReactIcon,
  tailwindcss: TailwindIcon,
} as const;
---

<section
  class="border-b border-(--border-subtle) bg-(--bg-surface) py-8 transition-colors"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-6"
    >
      <div class="max-w-xs">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-widest text-(--primary)"
        >
          Technology Stack
        </span>
        <p class="text-sm font-medium text-(--text-secondary) mt-1">
          Pages that load fast, stay fast worldwide, and get found in search.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-7 gap-3 flex-1">
        {technologies.map((tech) => {
          const Icon = icons[tech.slug as keyof typeof icons];
          return (
            <a
              class="group rounded border border-(--border-subtle) bg-(--bg-canvas) p-3 text-center transition-all hover:border-(--border-hover) hover:bg-(--bg-surface-elevated) focus-visible:outline-none focus-visible:ring-(--primary) focus-visible:ring-2"
              href={`#why-${tech.slug}`}
            >
              <Icon
                aria-hidden="true"
                class="m-2.5 mx-auto h-12 w-12 text-(--text-primary)"
              />
              <div class="mb-2 font-bold font-mono text-(--text-primary) transition-colors group-hover:text-(--primary)">
                {tech.name}
              </div>
              <div class="mt-0.5 text-(--text-muted) text-sm leading-tight">
                {tech.role}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>
