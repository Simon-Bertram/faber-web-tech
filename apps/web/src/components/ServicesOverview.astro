---
// ServicesOverview.astro - Detailed 3-Tier Value Proposition Breakdown
import CheckIcon from "../assets/icons/check.svg";
import ChevronRightIcon from "../assets/icons/chevron-right.svg";

interface Feature {
  description: string;
  title: string;
}

interface MetricBenchmark {
  label: string;
  value: string;
}

interface StackTopologyItem {
  label: string;
  value: string;
}

interface PipelineStage {
  description: string;
  stage: string;
}

interface ServiceVisual {
  footnote: string;
  headerBadge: string;
  headerBadgeColor: string;
  headerTitle: string;
  metrics?: MetricBenchmark[];
  pipeline?: PipelineStage[];
  topology?: StackTopologyItem[];
  type: "metrics" | "topology" | "pipeline";
}

interface ServiceTier {
  accent: "primary" | "secondary" | "tertiary";
  category: string;
  cta: {
    label: string;
    href: string;
  };
  description: string;
  features: Feature[];
  id: string;
  tierNumber: string;
  title: string;
  visual: ServiceVisual;
}

const accentStyles = {
  primary: {
    badgeBg: "bg-(--primary-container)",
    hoverBorder: "hover:border-(--primary)/50",
    text: "text-(--primary)",
  },
  secondary: {
    badgeBg: "bg-(--secondary-container)",
    hoverBorder: "hover:border-(--secondary)/50",
    text: "text-(--secondary)",
  },
  tertiary: {
    badgeBg: "bg-(--tertiary-container)",
    hoverBorder: "hover:border-(--tertiary)/50",
    text: "text-(--tertiary)",
  },
} as const;

const services: ServiceTier[] = [
  {
    accent: "primary",
    category: "Marketing Sites & Brand Platforms",
    cta: {
      href: "/#contact",
      label: "Consult on your website project",
    },
    description:
      "A slow website kills conversion rates before your pitch is even read. We engineer ultra-fast marketing websites using modern Astro island architectures, delivering sub-second Largest Contentful Paint (LCP) and dominating Google organic search rankings.",
    features: [
      {
        description: "Zero hydration bloat for instant interactivity.",
        title: "100/100 Core Web Vitals:",
      },
      {
        description: "Automated JSON-LD structured data and semantic markup.",
        title: "Deep Technical SEO:",
      },
      {
        description:
          "Fully accessible to all users with tested screen reader support.",
        title: "WCAG 2.1 AA Compliant:",
      },
      {
        description:
          "High-contrast CTA funnels designed to turn clicks into clients.",
        title: "Conversion Focused:",
      },
    ],
    id: "modern-websites",
    tierNumber: "01",
    title: "Modern Websites: High-Performance, SEO-Optimized Marketing Engines",
    visual: {
      footnote: "Measured via Google Lighthouse Mobile emulation.",
      headerBadge: "TARGET: 100/100",
      headerBadgeColor: "text-emerald-500",
      headerTitle: "METRIC BENCHMARKS",
      metrics: [
        { label: "First Contentful Paint (FCP)", value: "< 0.4s" },
        { label: "Largest Contentful Paint (LCP)", value: "< 0.8s" },
        { label: "Speed Index", value: "< 0.9s" },
      ],
      type: "metrics",
    },
  },
  {
    accent: "secondary",
    category: "Full-Stack Products & SaaS",
    cta: {
      href: "/#contact",
      label: "Plan your web application",
    },
    description:
      "Say goodbye to slow cold starts, brittle API handshakes, and heavy infrastructure maintenance costs. We architect full-stack applications on globally distributed edge networks, delivering blazing speed, end-to-end type safety, and real-time reactive user interfaces.",
    features: [
      {
        description:
          "oRPC ensures zero contract drift between frontend and backend.",
        title: "End-to-End Type Safety:",
      },
      {
        description: "Cloudflare D1 with Drizzle ORM for instant querying.",
        title: "Serverless Edge Relational SQL:",
      },
      {
        description:
          "Better-Auth session tokens, CSRF protection, and role-based ACLs.",
        title: "Hardened Authentication:",
      },
      {
        description:
          "Zero server management with automatic global replication.",
        title: "Infinite Scalability:",
      },
    ],
    id: "web-apps",
    tierNumber: "02",
    title: "Web Apps: Reactive Digital Products & Edge SaaS Platforms",
    visual: {
      footnote: "Standardized stack reduces technical debt to zero.",
      headerBadge: "EDGE NATIVE",
      headerBadgeColor: "text-(--secondary)",
      headerTitle: "STACK TOPOLOGY",
      topology: [
        { label: "Frontend Client", value: "Astro Islands" },
        { label: "API RPC Contract", value: "oRPC + OpenAPI" },
        { label: "Server Runtime", value: "Hono @ Cloudflare Workers" },
        { label: "Database", value: "D1 (SQLite) + Drizzle ORM" },
      ],
      type: "topology",
    },
  },
  {
    accent: "tertiary",
    category: "LLM Workflows & Intelligent Pipelines",
    cta: {
      href: "/#contact",
      label: "Discuss your AI automation use case",
    },
    description:
      "Generic AI wrappers deliver hallucinations; engineered AI pipelines unlock real operational leverage. We implement tailored multi-step agentic workflows, semantic search indexes, and enterprise integrations that automate critical business processes safely.",
    features: [
      {
        description: "Zod-validated JSON responses for guaranteed reliability.",
        title: "Deterministic Structured Schemas:",
      },
      {
        description:
          "Multi-turn tool execution, external API calling, and triage.",
        title: "Custom Agentic Pipelines:",
      },
      {
        description: "Zero training retention with strict perimeter isolation.",
        title: "Enterprise Privacy & Security:",
      },
      {
        description: "Real-time Evlog audit trails and token monitoring.",
        title: "Telemetry & Error Observability:",
      },
    ],
    id: "ai-automation",
    tierNumber: "03",
    title: "AI Applications & Automation: Custom LLMs & Workflow Autonomy",
    visual: {
      footnote: "Estimated operational time reduction: 65% - 85%.",
      headerBadge: "EVENT DRIVEN",
      headerBadgeColor: "text-(--tertiary)",
      headerTitle: "AUTOMATION PIPELINE",
      pipeline: [
        {
          description: "Customer Inquiries / Document Drops",
          stage: "Input",
        },
        {
          description: "Semantic Classification & Entity Extraction",
          stage: "Agent",
        },
        {
          description: "ERP/CRM Auto-Draft, Ticket Resolution",
          stage: "Action",
        },
      ],
      type: "pipeline",
    },
  },
];
---

<!-- ServicesOverview.astro - Detailed 3-Tier Value Proposition Breakdown -->
<section
  class="py-16 md:py-24 bg-(--bg-canvas) transition-colors"
  id="services"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="inline-block rounded-full border border-(--primary)/30 bg-(--primary-container) px-3.5 py-1 font-mono text-xs font-semibold text-(--primary) uppercase tracking-widest mb-3"
      >
        Engineered Solutions
      </span>
      <h2
        class="text-3xl sm:text-4xl font-extrabold tracking-tight text-(--text-primary)"
      >
        Three Core Service Tiers. Built for Growth.
      </h2>
      <p
        class="mt-4 text-base sm:text-lg text-(--text-secondary) leading-relaxed"
      >
        We eliminate obsolete tech stacks, slow server roundtrips, and bloated
        JavaScript frameworks to deliver digital experiences that captivate
        visitors and drive measurable business results.
      </p>
    </div>

    <!-- Service Tiers List -->
    {services.map((service, index) => {
        const styles = accentStyles[service.accent];
        return (
          <div
            class={`rounded-xl border border-(--border-subtle) bg-(--bg-surface) p-6 sm:p-8 lg:p-10 shadow-sm transition-all ${styles.hoverBorder} hover:shadow-md ${
              index < services.length - 1 ? "mb-12" : ""
            }`}
            id={service.id}
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              <div class="lg:col-span-7">
                <div class="flex items-center gap-2 mb-3">
                  <span
                    class={`inline-flex h-6 w-6 items-center justify-center rounded ${styles.badgeBg} ${styles.text} font-mono text-xs font-bold`}
                  >
                    {service.tierNumber}
                  </span>
                  <span
                    class={`font-mono text-xs font-semibold uppercase tracking-wider ${styles.text}`}
                  >
                    {service.category}
                  </span>
                </div>

                <h3 class="text-2xl sm:text-3xl font-bold text-(--text-primary) tracking-tight mb-4">
                  {service.title}
                </h3>

                <p class="text-base text-(--text-secondary) leading-relaxed mb-6">
                  {service.description}
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                  {service.features.map((feature) => (
                    <div class="flex items-start gap-2.5">
                      <CheckIcon
                        aria-hidden="true"
                        class={`h-5 w-5 ${styles.text} shrink-0 mt-0.5`}
                        role="img"
                      />
                      <span class="text-sm text-(--text-secondary)">
                        <strong>{feature.title}</strong> {feature.description}
                      </span>
                    </div>
                  ))}
                </div>

                <a
                  class={`inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider ${styles.text} hover:underline`}
                  href={service.cta.href}
                >
                  <span>{service.cta.label}</span>
                  <ChevronRightIcon
                    aria-hidden="true"
                    class="h-4 w-4"
                    role="img"
                  />
                </a>
              </div>

              <div class="lg:col-span-5">
                <div class="rounded-lg border border-(--border-subtle) bg-(--bg-canvas) p-6 space-y-4">
                  <div class="flex items-center justify-between border-b border-(--border-subtle) pb-3">
                    <span class="font-mono text-xs font-semibold text-(--text-primary)">
                      {service.visual.headerTitle}
                    </span>
                    <span
                      class={`font-mono text-[11px] font-bold ${service.visual.headerBadgeColor}`}
                    >
                      {service.visual.headerBadge}
                    </span>
                  </div>

                  {service.visual.type === "metrics" &&
                    service.visual.metrics && (
                      <div class="space-y-3">
                        {service.visual.metrics.map((metric) => (
                          <div>
                            <div class="flex justify-between text-xs font-mono mb-1">
                              <span class="text-(--text-secondary)">
                                {metric.label}
                              </span>
                              <span class="font-bold text-emerald-500">
                                {metric.value}
                              </span>
                            </div>
                            <div class="h-1.5 w-full rounded-full bg-(--bg-surface-elevated) overflow-hidden">
                              <div class="h-full w-full bg-emerald-500 rounded-full" />
                            </div>
                          </div>
                        ))}
                      </div>
                    )}

                  {service.visual.type === "topology" &&
                    service.visual.topology && (
                      <div class="space-y-2 font-mono text-xs text-(--text-secondary)">
                        {service.visual.topology.map((item) => (
                          <div class="flex items-center justify-between p-2 rounded bg-(--bg-surface-elevated)">
                            <span>{item.label}</span>
                            <span class="font-bold text-(--text-primary)">
                              {item.value}
                            </span>
                          </div>
                        ))}
                      </div>
                    )}

                  {service.visual.type === "pipeline" &&
                    service.visual.pipeline && (
                      <div class="space-y-3 font-mono text-xs text-(--text-secondary)">
                        {service.visual.pipeline.map((step) => (
                          <div class="p-2.5 rounded border border-(--border-subtle) bg-(--bg-surface-elevated)">
                            <span class="text-(--text-muted)">
                              {step.stage}:
                            </span>{" "}
                            {step.description}
                          </div>
                        ))}
                      </div>
                    )}

                  <p class="text-xs text-(--text-muted) font-mono pt-2 border-t border-(--border-subtle)">
                    {service.visual.footnote}
                  </p>
                </div>
              </div>
            </div>
          </div>
        );
      })}
  </div>
</section>
