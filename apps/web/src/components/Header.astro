---
import { NAV_LINKS as links } from "./nav/urls";
---

<div>
  <div class="flex flex-row items-center justify-between px-4 py-2 md:px-6">
    <nav class="flex gap-4 text-lg">
      {
        links.map((link: { label: string; to: string }) => (
          <a
            href={link.to}
            class="text-white transition-colors hover:text-neutral-400"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2" id="user-menu-container">
      <a
        href="/login"
        id="login-link"
        class="rounded bg-indigo-600 px-3 py-1.5 text-sm text-white transition-colors hover:bg-indigo-700"
      >
        Sign In
      </a>
      <div id="user-menu" class="flex hidden items-center gap-3">
        <span
          class="hidden text-sm text-neutral-400 sm:inline"
          id="user-display"></span>
        <button
          id="signout-button"
          class="rounded bg-red-600 px-3 py-1.5 text-sm text-white transition-colors hover:bg-red-700"
        >
          Sign Out
        </button>
      </div>
    </div>
  </div>
  <hr class="border-neutral-800" />
</div>

<script>
  import { authClient } from "../lib/auth-client";

  const loginLink = document.getElementById("login-link");
  const userMenu = document.getElementById("user-menu");
  const userDisplay = document.getElementById("user-display");
  const signOutButton = document.getElementById("signout-button");

  async function checkSession() {
    try {
      const { data: session } = await authClient.getSession();
      if (session?.user) {
        loginLink?.classList.add("hidden");
        userMenu?.classList.remove("hidden");
        if (userDisplay) {
          userDisplay.textContent =
            session.user.name || session.user.email?.split("@")[0] || "User";
        }
      }
    } catch (e) {
      // Not logged in
    }
  }

  signOutButton?.addEventListener("click", async () => {
    await authClient.signOut({
      fetchOptions: {
        onSuccess: () => {
          window.location.href = "/";
        },
      },
    });
  });

  checkSession();
</script>
