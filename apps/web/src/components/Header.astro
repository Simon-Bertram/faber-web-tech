---
import ThemeToggle from "./ThemeToggle.astro";

const navLinks = [
  { label: "Overview", to: "/" },
  { label: "Modern Websites", to: "/#modern-websites" },
  { label: "Web Apps", to: "/#web-apps" },
  { label: "AI Automation", to: "/#ai-automation" },
  { label: "Dashboard", to: "/dashboard" },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--border-subtle)] bg-[var(--glass-bg)] backdrop-blur-md transition-colors"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Brand Logo -->
    <a
      aria-label="Faber Web Tech - Return to Homepage"
      class="group flex items-center gap-2 text-lg font-bold tracking-tight text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] rounded-md py-1 px-1.5"
      href="/"
    >
      <span
        class="flex h-8 w-8 items-center justify-center rounded border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] font-mono text-sm font-semibold text-[var(--primary)] transition-transform group-hover:scale-105"
      >
        F
      </span>
      <span class="font-display tracking-tight text-xl font-bold">
        FABER<span class="text-[var(--primary)]">.</span
        ><span
          class="font-mono text-xs uppercase tracking-widest text-[var(--text-muted)] font-normal ml-1"
          >TECH</span
        >
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <a
          href={link.to}
          class="text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] rounded py-1 px-1.5"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions (Theme Toggle & Auth) -->
    <div class="flex items-center gap-3">
      <ThemeToggle />

      <div class="flex items-center gap-2" id="user-menu-container">
        <a
          class="inline-flex items-center justify-center rounded px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-white bg-[var(--primary)] transition-all hover:bg-[var(--primary-hover)] hover:shadow-[0_2px_12px_var(--primary-glow)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
          href="/login"
          id="login-link"
        >
          Sign In
        </a>

        <div class="hidden flex items-center gap-3" id="user-menu">
          <span
            class="hidden text-xs font-mono text-[var(--text-muted)] sm:inline"
            id="user-display"
          ></span>
          <button
            class="rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-red-500/50 hover:text-red-500 hover:bg-red-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500"
            id="signout-button"
            type="button"
          >
            Sign Out
          </button>
        </div>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class="inline-flex md:hidden h-10 w-10 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
        id="mobile-menu-button"
        type="button"
      >
        <!-- Open Hamburger SVG -->
        <svg
          class="h-5 w-5"
          fill="none"
          id="hamburger-icon"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 6h16M4 12h16M4 18h16"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
        <!-- Close X SVG -->
        <svg
          class="hidden h-5 w-5"
          fill="none"
          id="close-icon"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M6 18L18 6M6 6l12 12"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    aria-label="Mobile Navigation"
    class="hidden md:hidden border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 pt-3 pb-5 transition-all shadow-lg"
    id="mobile-nav"
  >
    <div class="flex flex-col gap-2">
      {navLinks.map((link) => (
        <a
          href={link.to}
          class="rounded-md px-3 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-surface-elevated)] hover:text-[var(--primary)] transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  import { authClient } from "../lib/auth-client";

  // Auth State Handling
  const loginLink = document.getElementById("login-link");
  const userMenu = document.getElementById("user-menu");
  const userDisplay = document.getElementById("user-display");
  const signOutButton = document.getElementById("signout-button");

  async function checkSession() {
    try {
      const { data: session } = await authClient.getSession();
      if (session?.user) {
        loginLink?.classList.add("hidden");
        userMenu?.classList.remove("hidden");
        if (userDisplay) {
          userDisplay.textContent =
            session.user.name || session.user.email?.split("@")[0] || "User";
        }
      }
    } catch (_) {
      // Not logged in
    }
  }

  signOutButton?.addEventListener("click", async () => {
    await authClient.signOut({
      fetchOptions: {
        onSuccess: () => {
          window.location.href = "/";
        },
      },
    });
  });

  checkSession();

  // Mobile Menu Toggle Handling
  const menuBtn = document.getElementById("mobile-menu-button");
  const mobileNav = document.getElementById("mobile-nav");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  menuBtn?.addEventListener("click", () => {
    const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
    menuBtn.setAttribute("aria-expanded", String(!isExpanded));
    mobileNav?.classList.toggle("hidden");
    hamburgerIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });

  // Close mobile menu on escape key
  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      menuBtn?.getAttribute("aria-expanded") === "true"
    ) {
      menuBtn.setAttribute("aria-expanded", "false");
      mobileNav?.classList.add("hidden");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
      menuBtn.focus();
    }
  });

  // Close mobile menu when clicking nav link
  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuBtn?.setAttribute("aria-expanded", "false");
      mobileNav?.classList.add("hidden");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  });
</script>
