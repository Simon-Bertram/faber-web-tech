---
import AuthMenu from "./AuthMenu.astro";
import BrandLogo from "./BrandLogo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const navLinks = [
  { label: "Overview", to: "/" },
  { label: "Modern Websites", to: "/#modern-websites" },
  { label: "Web Apps", to: "/#web-apps" },
  { label: "AI Automation", to: "/#ai-automation" },
  { label: "SEO & GEO", to: "/#seo-geo" },
  { label: "Contact", to: "/contact" },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-(--border-subtle) bg-(--glass-bg) backdrop-blur-md transition-colors"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Brand Logo -->
    <BrandLogo class="py-1 px-1.5" size="md" />

    <!-- Desktop Navigation Links -->
    <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-5">
      {navLinks.map((link) => (
          <a
            href={link.to}
            class="rounded px-1.5 py-1 font-medium text-(--text-secondary) text-sm transition-colors hover:text-(--primary) focus-visible:outline-none focus-visible:ring-(--primary) focus-visible:ring-2"
          >
            {link.label}
          </a>
        ))}
    </nav>

    <!-- Header Actions (Theme Toggle & Auth) -->
    <div class="flex items-center gap-3">
      <ThemeToggle />
      <AuthMenu />

      <!-- Mobile Hamburger Button -->
      <button
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class="inline-flex lg:hidden h-10 w-10 items-center justify-center rounded-md border border-(--border-subtle) bg-(--bg-surface) text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--bg-surface-elevated) focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--primary)"
        id="mobile-menu-button"
        type="button"
      >
        <!-- Open Hamburger SVG -->
        <svg
          aria-label="menu open icon"
          class="h-5 w-5"
          fill="none"
          id="hamburger-icon"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 6h16M4 12h16M4 18h16"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          ></path>
        </svg>
        <!-- Close X SVG -->
        <svg
          aria-label="menu close icon"
          class="hidden h-5 w-5"
          fill="none"
          id="close-icon"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M6 18L18 6M6 6l12 12"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <nav
    aria-label="Mobile Navigation"
    class="hidden lg:hidden border-t border-(--border-subtle) bg-(--bg-surface) px-4 pt-3 pb-5 transition-all shadow-lg"
    id="mobile-nav"
  >
    <div class="flex flex-col gap-2">
      {navLinks.map((link) => (
          <a
            href={link.to}
            class="rounded-md px-3 py-2 font-medium text-(--text-secondary) text-sm transition-colors hover:bg-(--bg-surface-elevated) hover:text-(--primary)"
          >
            {link.label}
          </a>
        ))}
    </div>
  </nav>
</header>

<script>
  // Mobile Menu Toggle Handling
  const menuBtn = document.getElementById("mobile-menu-button");
  const mobileNav = document.getElementById("mobile-nav");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  menuBtn?.addEventListener("click", () => {
    const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
    menuBtn.setAttribute("aria-expanded", String(!isExpanded));
    mobileNav?.classList.toggle("hidden");
    hamburgerIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });

  // Close mobile menu on escape key
  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      menuBtn?.getAttribute("aria-expanded") === "true"
    ) {
      menuBtn.setAttribute("aria-expanded", "false");
      mobileNav?.classList.add("hidden");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
      menuBtn.focus();
    }
  });

  // Close mobile menu when clicking nav link
  const navLinks = mobileNav?.querySelectorAll("a") ?? [];
  for (const link of navLinks) {
    link.addEventListener("click", () => {
      menuBtn?.setAttribute("aria-expanded", "false");
      mobileNav?.classList.add("hidden");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  }
</script>
