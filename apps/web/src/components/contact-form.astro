---
import { actions, isInputError } from "astro:actions";

const result = Astro.getActionResult(actions.contact);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const hasSubmitted = result?.data?.submitted === true;
const formError =
  result?.error && !isInputError(result.error)
    ? result.error.message
    : undefined;

const fieldClass =
  "min-h-11 w-full rounded border border-(--border-subtle) bg-(--bg-canvas) px-4 py-2.5 text-(--text-primary) placeholder:text-(--text-muted) transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--primary)";
const labelClass = "mb-1.5 block font-medium text-(--text-primary) text-sm";
const errorClass = "mt-1.5 text-rose-600 text-sm dark:text-rose-400";

const projectTypes = [
  { id: "website", label: "Modern Website" },
  { id: "web-app", label: "Web App" },
  { id: "ai-automation", label: "AI Automation" },
  { id: "not-sure", label: "Not sure yet" },
] as const;

const budgets = [
  { label: "Select a range", value: "" },
  { label: "Under $5k", value: "under-5k" },
  { label: "$5k–$15k", value: "5k-15k" },
  { label: "$15k–$40k", value: "15k-40k" },
  { label: "$40k+", value: "40k-plus" },
  { label: "Not sure", value: "not-sure" },
] as const;

const timelines = [
  { label: "Select a timeline", value: "" },
  { label: "ASAP", value: "asap" },
  { label: "1–3 months", value: "1-3-months" },
  { label: "3–6 months", value: "3-6-months" },
  { label: "Exploring", value: "exploring" },
] as const;
---

{hasSubmitted ? (
    <div
      class="rounded-xl border border-(--border-subtle) bg-(--bg-surface) p-8 shadow-(--card-shadow)"
      role="status"
    >
      <p class="mb-2 font-mono font-semibold text-(--primary) text-xs uppercase tracking-widest">
        Message sent
      </p>
      <h2 class="mb-3 font-extrabold text-(--text-primary) text-2xl tracking-tight">
        Thanks — we have your project brief.
      </h2>
      <p class="text-(--text-secondary) leading-relaxed">
        We’ll review what you want to achieve and reply from
        contact@faberwebtech.com. Most introductions come back within one
        business day.
      </p>
    </div>
  ) : (
    <form
      action={actions.contact}
      class="relative space-y-6 rounded-xl border border-(--border-subtle) bg-(--bg-surface) p-6 shadow-(--card-shadow) sm:p-8"
      method="POST"
    >
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class={labelClass} for="contact-name">
            Name <span class="text-(--primary)">*</span>
          </label>
          <input
            aria-describedby={inputErrors.name ? "contact-name-error" : undefined}
            aria-invalid={Boolean(inputErrors.name)}
            autocomplete="name"
            class={fieldClass}
            id="contact-name"
            name="name"
            required
            type="text"
          />
          {inputErrors.name && (
            <p class={errorClass} id="contact-name-error">
              {inputErrors.name.join(" ")}
            </p>
          )}
        </div>

        <div>
          <label class={labelClass} for="contact-email">
            Email <span class="text-(--primary)">*</span>
          </label>
          <input
            aria-describedby={
              inputErrors.email ? "contact-email-error" : undefined
            }
            aria-invalid={Boolean(inputErrors.email)}
            autocomplete="email"
            class={fieldClass}
            id="contact-email"
            name="email"
            required
            type="email"
          />
          {inputErrors.email && (
            <p class={errorClass} id="contact-email-error">
              {inputErrors.email.join(" ")}
            </p>
          )}
        </div>
      </div>

      <div>
        <label class={labelClass} for="contact-company">
          Company
        </label>
        <input
          aria-describedby={
            inputErrors.company ? "contact-company-error" : undefined
          }
          aria-invalid={Boolean(inputErrors.company)}
          autocomplete="organization"
          class={fieldClass}
          id="contact-company"
          name="company"
          type="text"
        />
        {inputErrors.company && (
          <p class={errorClass} id="contact-company-error">
            {inputErrors.company.join(" ")}
          </p>
        )}
      </div>

      <fieldset
        aria-describedby={
          inputErrors.projectType ? "contact-project-type-error" : undefined
        }
        aria-invalid={Boolean(inputErrors.projectType)}
      >
        <legend class={`${labelClass} mb-3`}>
          Project type <span class="text-(--primary)">*</span>
        </legend>
        <div class="grid gap-2 sm:grid-cols-2">
          {projectTypes.map((option) => (
            <label
              class="flex min-h-11 cursor-pointer items-center gap-3 rounded border border-(--border-subtle) bg-(--bg-canvas) px-4 py-2.5 text-(--text-primary) text-sm transition-colors hover:border-(--border-hover) has-[:focus-visible]:ring-(--primary) has-[:focus-visible]:ring-2"
            >
              <input
                class="h-4 w-4 accent-(--primary)"
                name="projectType"
                required
                type="radio"
                value={option.id}
              />
              {option.label}
            </label>
          ))}
        </div>
        {inputErrors.projectType && (
          <p class={errorClass} id="contact-project-type-error">
            {inputErrors.projectType.join(" ")}
          </p>
        )}
      </fieldset>

      <div>
        <label class={labelClass} for="contact-goals">
          What do you want this project to achieve?{" "}
          <span class="text-(--primary)">*</span>
        </label>
        <textarea
          aria-describedby={
            inputErrors.goals ? "contact-goals-error" : undefined
          }
          aria-invalid={Boolean(inputErrors.goals)}
          class={`${fieldClass} min-h-32 resize-y`}
          id="contact-goals"
          maxlength="5000"
          minlength="10"
          name="goals"
          placeholder="Tell us the outcome you need — launch a faster marketing site, ship a SaaS product, or automate a workflow."
          required
        />
        {inputErrors.goals && (
          <p class={errorClass} id="contact-goals-error">
            {inputErrors.goals.join(" ")}
          </p>
        )}
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class={labelClass} for="contact-budget">
            Budget
          </label>
          <select
            aria-describedby={
              inputErrors.budget ? "contact-budget-error" : undefined
            }
            aria-invalid={Boolean(inputErrors.budget)}
            class={fieldClass}
            id="contact-budget"
            name="budget"
          >
            {budgets.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
          {inputErrors.budget && (
            <p class={errorClass} id="contact-budget-error">
              {inputErrors.budget.join(" ")}
            </p>
          )}
        </div>

        <div>
          <label class={labelClass} for="contact-timeline">
            Timeline
          </label>
          <select
            aria-describedby={
              inputErrors.timeline ? "contact-timeline-error" : undefined
            }
            aria-invalid={Boolean(inputErrors.timeline)}
            class={fieldClass}
            id="contact-timeline"
            name="timeline"
          >
            {timelines.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
          {inputErrors.timeline && (
            <p class={errorClass} id="contact-timeline-error">
              {inputErrors.timeline.join(" ")}
            </p>
          )}
        </div>
      </div>

      <div
        aria-hidden="true"
        class="absolute -left-[9999px] h-0 w-0 overflow-hidden"
      >
        <label for="contact-company-website">Company website</label>
        <input
          autocomplete="off"
          id="contact-company-website"
          name="company_website"
          tabindex="-1"
          type="text"
        />
      </div>

      {formError && (
        <p class={errorClass} role="alert">
          {formError}
        </p>
      )}

      <button
        class="inline-flex h-12 w-full items-center justify-center rounded bg-(--primary) px-8 font-semibold text-sm text-white uppercase tracking-wider shadow-lg transition-all hover:bg-(--primary-hover) hover:shadow-[0_4px_20px_var(--primary-glow)] focus-visible:outline-none focus-visible:ring-(--primary) focus-visible:ring-2 active:scale-[0.98]"
        type="submit"
      >
        Send project brief
      </button>
    </form>
  )}
