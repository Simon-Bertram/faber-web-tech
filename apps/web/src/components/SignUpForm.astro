---
import {
  authButtonClass,
  authFieldClass,
  authLabelClass,
} from "../lib/auth-ui";
---

<div class="mx-auto mt-10 w-full max-w-md p-6">
  <h1
    class="mb-2 text-center font-display font-bold text-3xl text-(--text-primary)"
  >
    Create account
  </h1>
  <p class="mb-6 text-center text-(--text-secondary) text-sm">
    Open registration for prospective and current clients. We’ll email you a
    one-time code.
  </p>

  <form class="space-y-4" id="signup-form">
    <div>
      <label class={authLabelClass} for="name">Name</label>
      <input
        autocomplete="name"
        class={authFieldClass}
        id="name"
        name="name"
        placeholder="Jane Doe"
        required
        type="text"
      >
    </div>

    <div>
      <label class={authLabelClass} for="email">Email</label>
      <input
        autocomplete="email"
        class={authFieldClass}
        id="email"
        name="email"
        placeholder="you@example.com"
        required
        type="email"
      >
    </div>

    <div class="hidden" id="otp-step">
      <label class={authLabelClass} for="otp">Email code</label>
      <input
        autocomplete="one-time-code"
        class={authFieldClass}
        id="otp"
        inputmode="numeric"
        name="otp"
        placeholder="123456"
        type="text"
      >
    </div>

    <p
      class="hidden text-rose-600 text-sm dark:text-rose-400"
      id="form-error"
    ></p>
    <p class="hidden text-(--text-secondary) text-sm" id="form-status"></p>

    <button class={authButtonClass} id="submit" type="submit">Send code</button>
  </form>

  <div class="mt-4 text-center">
    <a
      class="text-(--primary) text-sm hover:text-(--primary-hover)"
      href="/login"
    >
      Already have an account? Sign in
    </a>
  </div>
</div>

<script>
  import { authClient } from "../lib/auth-client";
  import { orpc } from "../lib/orpc";
  import { postAuthPath } from "../lib/portal-session";

  const form = document.getElementById("signup-form") as HTMLFormElement;
  const nameInput = document.getElementById("name") as HTMLInputElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const otpInput = document.getElementById("otp") as HTMLInputElement;
  const otpStep = document.getElementById("otp-step") as HTMLDivElement;
  const formError = document.getElementById(
    "form-error"
  ) as HTMLParagraphElement;
  const formStatus = document.getElementById(
    "form-status"
  ) as HTMLParagraphElement;
  const submitButton = document.getElementById("submit") as HTMLButtonElement;

  let otpSent = false;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    formError.classList.add("hidden");
    formStatus.classList.add("hidden");
    submitButton.disabled = true;

    try {
      if (!otpSent) {
        submitButton.textContent = "Sending...";
        const { error } = await authClient.emailOtp.sendVerificationOtp({
          email: emailInput.value,
          type: "sign-in",
        });
        if (error) {
          formError.textContent =
            error.message || "Could not send a code. Try again.";
          formError.classList.remove("hidden");
          return;
        }
        otpSent = true;
        otpStep.classList.remove("hidden");
        otpInput.required = true;
        submitButton.textContent = "Verify and create account";
        formStatus.textContent = "If that email can register, we sent a code.";
        formStatus.classList.remove("hidden");
        return;
      }

      submitButton.textContent = "Creating account...";
      await authClient.signIn.emailOtp(
        {
          email: emailInput.value,
          name: nameInput.value,
          otp: otpInput.value,
        },
        {
          onError: (ctx) => {
            formError.textContent =
              ctx.error.message || "Sign up failed. Please try again.";
            formError.classList.remove("hidden");
          },
          onSuccess: async (ctx) => {
            if (
              ctx.data &&
              typeof ctx.data === "object" &&
              "twoFactorRedirect" in ctx.data &&
              ctx.data.twoFactorRedirect
            ) {
              window.location.href = "/two-factor";
              return;
            }
            try {
              const profile = await orpc.me.getProfile();
              const role =
                typeof profile.user.role === "string"
                  ? profile.user.role
                  : "user";
              const twoFactorEnabled = Boolean(
                (profile.user as { twoFactorEnabled?: boolean })
                  .twoFactorEnabled
              );
              if (role === "admin" && !twoFactorEnabled) {
                window.location.href = "/admin/security/2fa";
                return;
              }
              window.location.href = postAuthPath(role);
            } catch {
              window.location.href = "/dashboard";
            }
          },
        }
      );
    } catch {
      formError.textContent = "An unexpected error occurred.";
      formError.classList.remove("hidden");
    } finally {
      submitButton.disabled = false;
      if (!otpSent) {
        submitButton.textContent = "Send code";
      } else if (submitButton.textContent === "Creating account...") {
        submitButton.textContent = "Verify and create account";
      }
    }
  });
</script>
