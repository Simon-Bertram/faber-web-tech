---
const fieldClass =
  "min-h-11 w-full rounded border border-(--border-subtle) bg-(--bg-canvas) px-4 py-2.5 text-(--text-primary) placeholder:text-(--text-muted) transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--primary)";
const labelClass = "mb-1.5 block font-medium text-(--text-primary) text-sm";
---

<div class="mx-auto mt-10 w-full max-w-md p-6">
  <h1
    class="mb-2 text-center font-display font-bold text-3xl text-(--text-primary)"
  >
    Create account
  </h1>
  <p class="mb-6 text-center text-(--text-secondary) text-sm">
    Open registration for prospective and current clients.
  </p>

  <form class="space-y-4" id="signup-form">
    <div>
      <label class={labelClass} for="name">Name</label>
      <input
        autocomplete="name"
        class={fieldClass}
        id="name"
        name="name"
        placeholder="Jane Doe"
        required
        type="text"
      >
    </div>

    <div>
      <label class={labelClass} for="email">Email</label>
      <input
        autocomplete="email"
        class={fieldClass}
        id="email"
        name="email"
        placeholder="you@example.com"
        required
        type="email"
      >
    </div>

    <div>
      <label class={labelClass} for="password">Password</label>
      <input
        autocomplete="new-password"
        class={fieldClass}
        id="password"
        minlength="8"
        name="password"
        placeholder="••••••••"
        required
        type="password"
      >
      <p class="mt-1.5 text-(--text-muted) text-xs">
        Must be at least 8 characters
      </p>
    </div>

    <p
      class="hidden text-rose-600 text-sm dark:text-rose-400"
      id="form-error"
    ></p>

    <button
      class="inline-flex w-full min-h-11 items-center justify-center rounded bg-(--primary) px-4 py-2.5 font-semibold text-sm text-white transition-colors hover:bg-(--primary-hover) focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--primary) disabled:cursor-not-allowed disabled:opacity-50"
      type="submit"
    >
      Sign up
    </button>
  </form>

  <div class="mt-4 text-center">
    <a
      class="text-(--primary) text-sm hover:text-(--primary-hover)"
      href="/login"
    >
      Already have an account? Sign in
    </a>
  </div>
</div>

<script>
  import { authClient } from "../lib/auth-client";
  import { orpc } from "../lib/orpc";
  import { postAuthPath } from "../lib/portal-session";

  const form = document.getElementById("signup-form") as HTMLFormElement;
  const nameInput = document.getElementById("name") as HTMLInputElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const formError = document.getElementById(
    "form-error"
  ) as HTMLParagraphElement;
  const submitButton = form.querySelector(
    'button[type="submit"]'
  ) as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    formError.classList.add("hidden");
    submitButton.disabled = true;
    submitButton.textContent = "Creating account...";

    try {
      await authClient.signUp.email(
        {
          email: emailInput.value,
          name: nameInput.value,
          password: passwordInput.value,
        },
        {
          onError: (ctx) => {
            formError.textContent =
              ctx.error.message || "Sign up failed. Please try again.";
            formError.classList.remove("hidden");
          },
          onSuccess: async () => {
            try {
              const profile = await orpc.me.getProfile();
              window.location.href = postAuthPath(profile.user.role);
            } catch {
              window.location.href = "/dashboard";
            }
          },
        }
      );
    } catch {
      formError.textContent = "An unexpected error occurred.";
      formError.classList.remove("hidden");
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = "Sign up";
    }
  });
</script>
