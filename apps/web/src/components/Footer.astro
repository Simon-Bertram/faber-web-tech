---
import BrandLogo from "./BrandLogo.astro";

// Footer.astro - Semantic Footer with API Status Telemetry
const currentYear = new Date().getFullYear();

const footerNavigation = [
  {
    links: [
      { href: "/#modern-websites", label: "Modern Websites" },
      { href: "/#web-apps", label: "Web Applications (SaaS)" },
      { href: "/#ai-automation", label: "AI & Workflow Automation" },
      { href: "/#seo-geo", label: "SEO & GEO" },
    ],
    title: "Core Services",
  },
  {
    links: [
      { href: "/dashboard", label: "Client Dashboard" },
      { href: "/login", label: "Client Login" },
      { href: "/signup", label: "Register Account" },
      { href: "/contact", label: "Contact" },
    ],
    title: "Platform",
  },
];
---

<footer
  class="border-t border-(--border-subtle) bg-(--bg-canvas) py-12 text-sm text-(--text-secondary) transition-colors"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand Summary -->
      <div class="md:col-span-2">
        <BrandLogo class="mb-3" size="sm" />
        <p class="text-sm text-(--text-muted) max-w-sm mb-4 leading-relaxed">
          Modern web tech to boost your business. Delivering high-performance
          websites, scalable web applications, intelligent AI workflows, and
          search visibility that gets you recommended by Google and AI.
        </p>

        <!-- Live Server Health Status -->
        <div
          class="inline-flex items-center gap-2 rounded border border-(--border-subtle) bg-(--bg-surface) px-3 py-1.5 font-mono text-xs"
          id="api-status"
        >
          <div
            class="h-2 w-2 rounded-full bg-amber-500 animate-ping"
            id="footer-status-ping"
          ></div>
          <span class="text-(--text-muted)">Edge API:</span>
          <span
            class="font-semibold text-(--text-primary)"
            id="footer-status-text"
            >Checking status...</span
          >
        </div>
      </div>

      <!-- Navigation Sections -->
      {footerNavigation.map((section) => (
          <div>
            <h3 class="mb-3 font-mono font-semibold text-(--text-primary) text-xs uppercase tracking-widest">
              {section.title}
            </h3>
            <ul class="space-y-2 text-xs">
              {section.links.map((link) => (
                <li>
                  <a
                    class="transition-colors hover:text-(--primary)"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
    </div>

    <!-- Bottom Bar -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between border-t border-(--border-subtle) pt-6 text-xs text-(--text-muted) gap-4"
    >
      <p>&copy; {currentYear} Faber Web Tech. All rights reserved.</p>
      <p class="font-mono text-[11px]">
        Built with Astro, Cloudflare Workers & oRPC.
      </p>
    </div>
  </div>
</footer>

<script>
  import { orpc } from "../lib/orpc";

  const statusPing = document.getElementById("footer-status-ping");
  const statusText = document.getElementById("footer-status-text");

  async function checkHealth() {
    try {
      await orpc.healthCheck();
      if (statusPing && statusText) {
        statusPing.className = "h-2 w-2 rounded-full bg-emerald-500";
        statusText.textContent = "Connected (Healthy)";
        statusText.classList.add("text-emerald-500");
      }
    } catch {
      if (statusPing && statusText) {
        statusPing.className = "h-2 w-2 rounded-full bg-rose-500";
        statusText.textContent = "Offline";
        statusText.classList.add("text-rose-500");
      }
    }
  }

  checkHealth();
</script>
