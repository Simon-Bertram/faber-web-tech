---
import BrandLogo from "./BrandLogo.astro";
import EdgeApiStatus from "./EdgeApiStatus.astro";

// Footer.astro - Semantic Footer with API Status Telemetry
const currentYear = new Date().getFullYear();

const footerNavigation = [
  {
    links: [
      { href: "/#modern-websites", label: "Modern Websites" },
      { href: "/#web-apps", label: "Web Applications (SaaS)" },
      { href: "/#ai-automation", label: "AI & Workflow Automation" },
      { href: "/#seo-geo", label: "SEO & GEO" },
    ],
    title: "Core Services",
  },
  {
    links: [
      { href: "/dashboard", label: "Client Dashboard" },
      { href: "/login", label: "Client Login" },
      { href: "/signup", label: "Register Account" },
      { href: "/contact", label: "Contact" },
    ],
    title: "Platform",
  },
];
---

<footer
  class="border-t border-(--border-subtle) bg-(--bg-canvas) py-12 text-sm text-(--text-secondary) transition-colors"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand Summary -->
      <div class="md:col-span-2">
        <BrandLogo class="mb-3" size="sm" />
        <p class="text-sm text-(--text-muted) max-w-sm mb-4 leading-relaxed">
          Modern web tech to boost your business. Delivering high-performance
          websites, scalable web applications, intelligent AI workflows, and
          search visibility that gets you recommended by Google and AI.
        </p>

        <EdgeApiStatus />
      </div>

      <!-- Navigation Sections -->
      {footerNavigation.map((section) => (
          <div>
            <h3 class="mb-3 font-mono font-semibold text-(--text-primary) text-xs uppercase tracking-widest">
              {section.title}
            </h3>
            <ul class="space-y-2 text-xs">
              {section.links.map((link) => (
                <li>
                  <a
                    class="transition-colors hover:text-(--primary)"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
    </div>

    <!-- Bottom Bar -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between border-t border-(--border-subtle) pt-6 text-xs text-(--text-muted) gap-4"
    >
      <p>&copy; {currentYear} Faber Web Tech. All rights reserved.</p>
      <p class="font-mono text-[11px]">
        Built with Astro, Cloudflare Workers & oRPC.
      </p>
    </div>
  </div>
</footer>
