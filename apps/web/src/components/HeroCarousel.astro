---
// HeroCarousel.astro - WCAG 2.1 AA Accessible Dynamic Slideshow
const slides = [
  {
    id: "modern-websites",
    tier: "TIER 01 // MARKETING & BRAND",
    title: "High-Performance, Conversion-Engineered Websites",
    description:
      "Speed is revenue. We engineer ultra-fast marketing websites with modern static and edge rendering architectures, achieving flawless 100/100 Core Web Vitals, organic search dominance, and maximum conversion rates.",
    primaryCtaText: "Start Your Website",
    primaryCtaLink: "/#contact",
    secondaryCtaText: "Explore Architecture",
    secondaryCtaLink: "/#modern-websites",
    accentColor: "var(--primary)",
    accentBg: "var(--primary-container)",
    badgeColor: "text-[var(--primary)] border-[var(--primary)]/30 bg-[var(--primary-container)]",
    previewType: "performance",
  },
  {
    id: "web-apps",
    tier: "TIER 02 // WEB APPS & SAAS",
    title: "Full-Stack SaaS & Scalable Digital Products",
    description:
      "Transform your vision into high-scale software. Built on modern edge infrastructure (Cloudflare Workers, Hono, oRPC, Drizzle D1), delivering sub-50ms global latency, end-to-end type safety, and real-time responsiveness.",
    primaryCtaText: "Build Your App",
    primaryCtaLink: "/#contact",
    secondaryCtaText: "Review Stack",
    secondaryCtaLink: "/#web-apps",
    accentColor: "var(--secondary)",
    accentBg: "var(--secondary-container)",
    badgeColor: "text-[var(--secondary)] border-[var(--secondary)]/30 bg-[var(--secondary-container)]",
    previewType: "architecture",
  },
  {
    id: "ai-automation",
    tier: "TIER 03 // INTELLIGENCE & AUTOMATION",
    title: "Intelligent Workflows & Custom LLM Systems",
    description:
      "Automate manual bottlenecks and multiply human output. We develop autonomous agentic pipelines, tailored LLM integrations, and self-healing business automations with strict validation and enterprise data security.",
    primaryCtaText: "Automate Your Business",
    primaryCtaLink: "/#contact",
    secondaryCtaText: "Explore AI Solutions",
    secondaryCtaLink: "/#ai-automation",
    accentColor: "var(--tertiary)",
    accentBg: "var(--tertiary-container)",
    badgeColor: "text-[var(--tertiary)] border-[var(--tertiary)]/30 bg-[var(--tertiary-container)]",
    previewType: "automation",
  },
];
---

<section
  id="hero-carousel"
  class="relative overflow-hidden pt-8 pb-16 md:pt-14 md:pb-24 border-b border-[var(--border-subtle)]"
  aria-roledescription="carousel"
  aria-label="Core Services Showcase"
>
  <!-- Background Kinetic Light Leaks / Ambient Gradients -->
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse_at_center,rgba(255,92,0,0.12),transparent_70%)] blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute top-1/3 -right-40 -z-10 h-[400px] w-[600px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(94,53,177,0.12),transparent_70%)] blur-3xl" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Brand Strapline Banner -->
    <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 py-1.5 text-xs font-mono tracking-wide shadow-sm">
      <span class="inline-block h-2 w-2 rounded-full bg-[var(--primary)] animate-pulse" aria-hidden="true"></span>
      <span class="font-semibold text-[var(--text-secondary)]">FABER WEB TECH:</span>
      <span class="font-medium text-[var(--text-primary)]">Modern web tech to boost your business.</span>
    </div>

    <!-- Carousel Viewport -->
    <div class="relative min-h-[480px] md:min-h-[420px]">
      {slides.map((slide, index) => (
        <div
          id={`slide-${index + 1}`}
          class={`hero-slide transition-opacity duration-500 ease-in-out ${
            index === 0 ? "relative opacity-100 z-10" : "absolute inset-0 opacity-0 pointer-events-none z-0"
          }`}
          role="group"
          aria-roledescription="slide"
          aria-label={`Slide ${index + 1} of ${slides.length}: ${slide.title}`}
          data-slide-index={index}
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <!-- Left Column: Copy & Actions -->
            <div class="lg:col-span-7 flex flex-col items-start">
              <!-- Tier Badge -->
              <span class={`inline-block rounded-full border px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider mb-4 ${slide.badgeColor}`}>
                {slide.tier}
              </span>

              <!-- Slide Headline -->
              <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.15] mb-4">
                {slide.title}
              </h1>

              <!-- Strapline Accent -->
              <p class="text-lg sm:text-xl font-medium text-[var(--primary)] mb-4">
                Modern web tech to boost your business.
              </p>

              <!-- Service Description -->
              <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed max-w-2xl mb-8">
                {slide.description}
              </p>

              <!-- Call to Actions -->
              <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
                <a
                  href={slide.primaryCtaLink}
                  class="inline-flex h-12 w-full sm:w-auto items-center justify-center rounded px-6 text-sm font-semibold uppercase tracking-wider text-white bg-[var(--primary)] shadow-md transition-all hover:bg-[var(--primary-hover)] hover:shadow-[0_4px_20px_var(--primary-glow)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
                >
                  {slide.primaryCtaText}
                  <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
                <a
                  href={slide.secondaryCtaLink}
                  class="inline-flex h-12 w-full sm:w-auto items-center justify-center rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-6 text-sm font-semibold uppercase tracking-wider text-[var(--text-primary)] transition-all hover:border-[var(--border-hover)] hover:bg-[var(--bg-surface-elevated)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
                >
                  {slide.secondaryCtaText}
                </a>
              </div>
            </div>

            <!-- Right Column: Interactive Tech Visual Mockup -->
            <div class="lg:col-span-5 w-full">
              {slide.previewType === "performance" && (
                <div class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 shadow-xl transition-all hover:border-[var(--border-hover)]">
                  <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4 mb-4">
                    <div class="flex items-center gap-2">
                      <span class="h-3 w-3 rounded-full bg-red-500"></span>
                      <span class="h-3 w-3 rounded-full bg-yellow-500"></span>
                      <span class="h-3 w-3 rounded-full bg-green-500"></span>
                      <span class="ml-2 font-mono text-xs text-[var(--text-muted)]">audit-report.json</span>
                    </div>
                    <span class="rounded bg-emerald-500/10 px-2 py-0.5 font-mono text-xs font-semibold text-emerald-500">
                      100% AUDIT PASS
                    </span>
                  </div>
                  
                  <div class="grid grid-cols-2 gap-3 mb-4">
                    <div class="rounded border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] p-3 text-center">
                      <div class="text-2xl font-bold font-mono text-emerald-500">100</div>
                      <div class="text-xs text-[var(--text-muted)] font-medium">Performance</div>
                    </div>
                    <div class="rounded border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] p-3 text-center">
                      <div class="text-2xl font-bold font-mono text-emerald-500">100</div>
                      <div class="text-xs text-[var(--text-muted)] font-medium">Accessibility</div>
                    </div>
                    <div class="rounded border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] p-3 text-center">
                      <div class="text-2xl font-bold font-mono text-emerald-500">100</div>
                      <div class="text-xs text-[var(--text-muted)] font-medium">Best Practices</div>
                    </div>
                    <div class="rounded border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] p-3 text-center">
                      <div class="text-2xl font-bold font-mono text-emerald-500">100</div>
                      <div class="text-xs text-[var(--text-muted)] font-medium">Technical SEO</div>
                    </div>
                  </div>

                  <div class="space-y-2 font-mono text-xs text-[var(--text-secondary)]">
                    <div class="flex justify-between border-b border-[var(--border-subtle)]/50 pb-1">
                      <span>Largest Contentful Paint (LCP)</span>
                      <span class="text-emerald-500 font-semibold">0.68s</span>
                    </div>
                    <div class="flex justify-between border-b border-[var(--border-subtle)]/50 pb-1">
                      <span>Interaction to Next Paint (INP)</span>
                      <span class="text-emerald-500 font-semibold">18ms</span>
                    </div>
                    <div class="flex justify-between">
                      <span>Cumulative Layout Shift (CLS)</span>
                      <span class="text-emerald-500 font-semibold">0.000</span>
                    </div>
                  </div>
                </div>
              )}

              {slide.previewType === "architecture" && (
                <div class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 shadow-xl transition-all hover:border-[var(--border-hover)]">
                  <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4 mb-4">
                    <div class="flex items-center gap-2">
                      <span class="h-3 w-3 rounded-full bg-red-500"></span>
                      <span class="h-3 w-3 rounded-full bg-yellow-500"></span>
                      <span class="h-3 w-3 rounded-full bg-green-500"></span>
                      <span class="ml-2 font-mono text-xs text-[var(--text-muted)]">edge-orpc.ts</span>
                    </div>
                    <span class="rounded bg-violet-500/10 px-2 py-0.5 font-mono text-xs font-semibold text-violet-500">
                      TYPESAFE RPC
                    </span>
                  </div>

                  <div class="font-mono text-xs leading-relaxed text-[var(--text-secondary)] space-y-1 mb-4">
                    <p><span class="text-[var(--secondary)]">const</span> <span class="text-[var(--primary)]">client</span> = createORPCClient({`{`}</p>
                    <p class="pl-4">url: <span class="text-emerald-500">"https://api.faber.tech"</span>,</p>
                    <p class="pl-4">runtime: <span class="text-violet-400">"Cloudflare Workers"</span>,</p>
                    <p class="pl-4">database: <span class="text-violet-400">"D1 / Drizzle ORM"</span>,</p>
                    <p>{`}`});</p>
                    <p class="pt-2 text-[var(--text-muted)]">// Latency benchmark across 300+ edge PoPs:</p>
                    <p class="text-emerald-500 font-semibold">Query latency: 28ms (Cold start: 0ms)</p>
                  </div>

                  <div class="flex items-center justify-between rounded bg-[var(--bg-surface-elevated)] p-2.5 font-mono text-xs border border-[var(--border-subtle)]">
                    <span class="text-[var(--text-muted)]">Edge Topology:</span>
                    <span class="font-semibold text-[var(--text-primary)]">Workers + D1 + KV</span>
                  </div>
                </div>
              )}

              {slide.previewType === "automation" && (
                <div class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 shadow-xl transition-all hover:border-[var(--border-hover)]">
                  <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4 mb-4">
                    <div class="flex items-center gap-2">
                      <span class="h-3 w-3 rounded-full bg-red-500"></span>
                      <span class="h-3 w-3 rounded-full bg-yellow-500"></span>
                      <span class="h-3 w-3 rounded-full bg-green-500"></span>
                      <span class="ml-2 font-mono text-xs text-[var(--text-muted)]">agent-workflow.json</span>
                    </div>
                    <span class="rounded bg-cyan-500/10 px-2 py-0.5 font-mono text-xs font-semibold text-cyan-500">
                      PIPELINE ACTIVE
                    </span>
                  </div>

                  <div class="space-y-3 font-mono text-xs">
                    <div class="flex items-center gap-2 rounded bg-[var(--bg-surface-elevated)] p-2.5 border border-[var(--border-subtle)]">
                      <span class="flex h-5 w-5 items-center justify-center rounded-full bg-cyan-500/20 text-cyan-500 font-bold">1</span>
                      <span class="text-[var(--text-primary)]">Event Trigger: Webhook Ingest</span>
                    </div>
                    <div class="flex items-center gap-2 rounded bg-[var(--bg-surface-elevated)] p-2.5 border border-[var(--border-subtle)]">
                      <span class="flex h-5 w-5 items-center justify-center rounded-full bg-cyan-500/20 text-cyan-500 font-bold">2</span>
                      <span class="text-[var(--text-primary)]">LLM Semantic Validation & Extraction</span>
                    </div>
                    <div class="flex items-center gap-2 rounded bg-[var(--bg-surface-elevated)] p-2.5 border border-[var(--border-subtle)]">
                      <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-500 font-bold">3</span>
                      <span class="text-emerald-500 font-semibold">Autonomous Database & CRM Sync</span>
                    </div>
                  </div>

                  <div class="mt-4 flex items-center justify-between text-xs font-mono text-[var(--text-muted)]">
                    <span>Model: Gemini / Claude / GPT</span>
                    <span class="text-cyan-500 font-semibold">Zero Data Leakage</span>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Carousel Controls Bar (Arrows, Tabs, and Pause/Play) -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-[var(--border-subtle)] pt-6">
      <!-- Tablist Indicators for 3 Service Tiers -->
      <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Carousel slide selection">
        {slides.map((slide, index) => (
          <button
            type="button"
            role="tab"
            id={`carousel-tab-${index}`}
            class={`carousel-tab inline-flex items-center gap-2 rounded px-3 py-1.5 text-xs font-mono transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] ${
              index === 0
                ? "border border-[var(--primary)] bg-[var(--primary-container)] text-[var(--primary)] font-bold shadow-sm"
                : "border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-hover)]"
            }`}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`slide-${index + 1}`}
            data-target-index={index}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
            <span>{index + 1}. {slide.id === "modern-websites" ? "Websites" : slide.id === "web-apps" ? "Web Apps" : "AI Automations"}</span>
          </button>
        ))}
      </div>

      <!-- Arrow Buttons & Pause/Play Control -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="carousel-pause-play"
          class="inline-flex h-10 w-10 items-center justify-center rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
          aria-label="Pause automatic slide rotation"
          title="Pause automatic slide rotation"
        >
          <!-- Pause Icon -->
          <svg id="pause-icon" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M6.75 5.25a.75.75 0 0 1 .75.75v12a.75.75 0 0 1-1.5 0v-12a.75.75 0 0 1 .75-.75Zm10.5 0a.75.75 0 0 1 .75.75v12a.75.75 0 0 1-1.5 0v-12a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
          </svg>
          <!-- Play Icon -->
          <svg id="play-icon" class="hidden h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
          </svg>
        </button>

        <button
          type="button"
          id="carousel-prev"
          class="inline-flex h-10 w-10 items-center justify-center rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
          aria-label="Previous slide"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          type="button"
          id="carousel-next"
          class="inline-flex h-10 w-10 items-center justify-center rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
          aria-label="Next slide"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initCarousel() {
    const carousel = document.getElementById("hero-carousel");
    if (!carousel) return;

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".hero-slide"));
    const tabs = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-tab"));
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    const pausePlayBtn = document.getElementById("carousel-pause-play");
    const pauseIcon = document.getElementById("pause-icon");
    const playIcon = document.getElementById("play-icon");

    let currentIndex = 0;
    let autoPlayInterval: number | null = null;
    let isPlaying = true;
    const intervalTime = 6000;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      isPlaying = false;
      updatePausePlayButton();
    }

    function goToSlide(newIndex: number) {
      if (newIndex === currentIndex) return;

      // Handle cyclic index
      if (newIndex < 0) {
        newIndex = slides.length - 1;
      } else if (newIndex >= slides.length) {
        newIndex = 0;
      }

      // Hide current slide
      const currentSlide = slides[currentIndex];
      currentSlide.classList.remove("relative", "opacity-100", "z-10");
      currentSlide.classList.add("absolute", "inset-0", "opacity-0", "pointer-events-none", "z-0");

      const currentTab = tabs[currentIndex];
      currentTab.setAttribute("aria-selected", "false");
      currentTab.className =
        "carousel-tab inline-flex items-center gap-2 rounded px-3 py-1.5 text-xs font-mono transition-all border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-hover)]";

      // Show new slide
      const nextSlide = slides[newIndex];
      nextSlide.classList.remove("absolute", "inset-0", "opacity-0", "pointer-events-none", "z-0");
      nextSlide.classList.add("relative", "opacity-100", "z-10");

      const nextTab = tabs[newIndex];
      nextTab.setAttribute("aria-selected", "true");
      nextTab.className =
        "carousel-tab inline-flex items-center gap-2 rounded px-3 py-1.5 text-xs font-mono transition-all border border-[var(--primary)] bg-[var(--primary-container)] text-[var(--primary)] font-bold shadow-sm";

      currentIndex = newIndex;
    }

    function startAutoPlay() {
      if (prefersReducedMotion || !isPlaying) return;
      stopAutoPlay();
      autoPlayInterval = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, intervalTime);
    }

    function stopAutoPlay() {
      if (autoPlayInterval !== null) {
        clearInterval(autoPlayInterval);
        autoPlayInterval = null;
      }
    }

    function updatePausePlayButton() {
      if (isPlaying) {
        pauseIcon?.classList.remove("hidden");
        playIcon?.classList.add("hidden");
        pausePlayBtn?.setAttribute("aria-label", "Pause automatic slide rotation");
        pausePlayBtn?.setAttribute("title", "Pause automatic slide rotation");
      } else {
        pauseIcon?.classList.add("hidden");
        playIcon?.classList.remove("hidden");
        pausePlayBtn?.setAttribute("aria-label", "Start automatic slide rotation");
        pausePlayBtn?.setAttribute("title", "Start automatic slide rotation");
      }
    }

    prevBtn?.addEventListener("click", () => {
      goToSlide(currentIndex - 1);
      if (isPlaying) startAutoPlay();
    });

    nextBtn?.addEventListener("click", () => {
      goToSlide(currentIndex + 1);
      if (isPlaying) startAutoPlay();
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        goToSlide(i);
        if (isPlaying) startAutoPlay();
      });
    });

    pausePlayBtn?.addEventListener("click", () => {
      isPlaying = !isPlaying;
      if (isPlaying) {
        startAutoPlay();
      } else {
        stopAutoPlay();
      }
      updatePausePlayButton();
    });

    // Pause on hover & on keyboard focus within carousel for WCAG compliance
    carousel.addEventListener("mouseenter", stopAutoPlay);
    carousel.addEventListener("mouseleave", () => {
      if (isPlaying) startAutoPlay();
    });
    carousel.addEventListener("focusin", stopAutoPlay);
    carousel.addEventListener("focusout", () => {
      if (isPlaying) startAutoPlay();
    });

    // Keyboard navigation (Arrow keys, Home, End)
    carousel.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        goToSlide(currentIndex - 1);
        tabs[currentIndex]?.focus();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        goToSlide(currentIndex + 1);
        tabs[currentIndex]?.focus();
      } else if (e.key === "Home") {
        e.preventDefault();
        goToSlide(0);
        tabs[0]?.focus();
      } else if (e.key === "End") {
        e.preventDefault();
        goToSlide(slides.length - 1);
        tabs[slides.length - 1]?.focus();
      }
    });

    startAutoPlay();
  }

  initCarousel();
  document.addEventListener("astro:after-swap", initCarousel);
</script>
