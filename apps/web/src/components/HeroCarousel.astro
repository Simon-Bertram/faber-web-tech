---
import ChevronRightIcon from "../assets/icons/chevron-right.svg";
import ArchitecturePreview from "./carousel/ArchitecturePreview.astro";
import AutomationPreview from "./carousel/AutomationPreview.astro";
import PerformancePreview from "./carousel/PerformancePreview.astro";

// HeroCarousel.astro - WCAG 2.1 AA Accessible Dynamic Slideshow
const slides = [
  {
    accentBg: "var(--primary-container)",
    accentColor: "var(--primary)",
    badgeColor:
      "text-[var(--primary)] border-[var(--primary)]/30 bg-[var(--primary-container)]",
    description:
      "Speed is revenue. We engineer ultra-fast marketing websites with modern static and edge rendering architectures, achieving flawless 100/100 Core Web Vitals, organic search dominance, and maximum conversion rates.",
    id: "modern-websites",
    previewType: "performance",
    primaryCtaLink: "/#contact",
    primaryCtaText: "Start Your Website",
    secondaryCtaLink: "/#modern-websites",
    secondaryCtaText: "Explore Architecture",
    tier: "TIER 01 // MARKETING & BRAND",
    title: "High-Performance, Conversion-Engineered Websites",
  },
  {
    accentBg: "var(--secondary-container)",
    accentColor: "var(--secondary)",
    badgeColor:
      "text-[var(--secondary)] border-[var(--secondary)]/30 bg-[var(--secondary-container)]",
    description:
      "Transform your vision into high-scale software. Built on modern edge infrastructure (Cloudflare Workers, Hono, oRPC, Drizzle D1), delivering sub-50ms global latency, end-to-end type safety, and real-time responsiveness.",
    id: "web-apps",
    previewType: "architecture",
    primaryCtaLink: "/#contact",
    primaryCtaText: "Build Your App",
    secondaryCtaLink: "/#web-apps",
    secondaryCtaText: "Review Stack",
    tier: "TIER 02 // WEB APPS & SAAS",
    title: "Full-Stack SaaS & Scalable Digital Products",
  },
  {
    accentBg: "var(--tertiary-container)",
    accentColor: "var(--tertiary)",
    badgeColor:
      "text-[var(--tertiary)] border-[var(--tertiary)]/30 bg-[var(--tertiary-container)]",
    description:
      "Automate manual bottlenecks and multiply human output. We develop autonomous agentic pipelines, tailored LLM integrations, and self-healing business automations with strict validation and enterprise data security.",
    id: "ai-automation",
    previewType: "automation",
    primaryCtaLink: "/#contact",
    primaryCtaText: "Automate Your Business",
    secondaryCtaLink: "/#ai-automation",
    secondaryCtaText: "Explore AI Solutions",
    tier: "TIER 03 // INTELLIGENCE & AUTOMATION",
    title: "Intelligent Workflows & Custom LLM Systems",
  },
];
---

<section
  aria-label="Core Services Showcase"
  aria-roledescription="carousel"
  class="relative overflow-hidden pt-8 pb-16 md:pt-14 md:pb-24 border-b border-(--border-subtle)"
  id="hero-carousel"
>
  <!-- Background Kinetic Light Leaks / Ambient Gradients -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-125 w-200 -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse_at_center,rgba(255,92,0,0.12),transparent_70%)] blur-3xl"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-1/3 -right-40 -z-10 h-[400px] w-[600px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(94,53,177,0.12),transparent_70%)] blur-3xl"
  ></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Brand Strapline Banner -->
    <div
      class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 py-1.5 text-xs font-mono tracking-wide shadow-sm"
    >
      <span
        aria-hidden="true"
        class="inline-block h-2 w-2 rounded-full bg-[var(--primary)] animate-pulse"
      ></span>
      <span class="font-semibold text-[var(--text-secondary)]"
        >FABER WEB TECH:</span
      >
      <span class="font-medium text-[var(--text-primary)]"
        >Modern web tech to boost your business.</span
      >
    </div>

    <!-- Carousel Viewport -->
    <div class="relative min-h-[480px] md:min-h-[420px]">
      {slides.map((slide, index) => (
          <section
            id={`slide-${index + 1}`}
            class={`hero-slide transition-opacity duration-500 ease-in-out ${
              index === 0
                ? "relative opacity-100 z-10"
                : "absolute inset-0 opacity-0 pointer-events-none z-0"
            }`}
            aria-roledescription="slide"
            aria-label={`Slide ${index + 1} of ${slides.length}: ${slide.title}`}
            data-slide-index={index}
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
              {/* Left Column: Copy & Actions */}
              <div class="lg:col-span-7 flex flex-col items-start">
                {/* Tier Badge */}
                <span
                  class={`inline-block rounded-full border px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider mb-4 ${slide.badgeColor}`}
                >
                  {slide.tier}
                </span>

                {/* Slide Headline */}
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.15] mb-4">
                  {slide.title}
                </h1>

                {/* Strapline Accent */}
                <p class="text-lg sm:text-xl font-medium text-[var(--primary)] mb-4">
                  Modern web tech to boost your business.
                </p>

                {/* Service Description */}
                <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed max-w-2xl mb-8">
                  {slide.description}
                </p>

                {/* Call to Actions */}
                <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
                  <a
                    href={slide.primaryCtaLink}
                    class="inline-flex h-12 w-full sm:w-auto items-center justify-center rounded px-6 text-sm font-semibold uppercase tracking-wider text-white bg-[var(--primary)] shadow-md transition-all hover:bg-[var(--primary-hover)] hover:shadow-[0_4px_20px_var(--primary-glow)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
                  >
                    {slide.primaryCtaText}
                    <svg
                      class="ml-2 h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                      />
                    </svg>
                  </a>
                  <a
                    href={slide.secondaryCtaLink}
                    class="inline-flex h-12 w-full sm:w-auto items-center justify-center rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-6 text-sm font-semibold uppercase tracking-wider text-[var(--text-primary)] transition-all hover:border-[var(--border-hover)] hover:bg-[var(--bg-surface-elevated)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
                  >
                    {slide.secondaryCtaText}
                  </a>
                </div>
              </div>

              {/* Right Column: Interactive Tech Visual Mockup */}
              <div class="lg:col-span-5 w-full">
                {slide.previewType === "performance" && <PerformancePreview />}
                {slide.previewType === "architecture" && (
                  <ArchitecturePreview />
                )}
                {slide.previewType === "automation" && <AutomationPreview />}
              </div>
            </div>
          </section>
        ))}
    </div>

    <!-- Carousel Controls Bar (Arrows, Tabs, and Pause/Play) -->
    <div
      class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-[var(--border-subtle)] pt-6"
    >
      <!-- Tablist Indicators for 3 Service Tiers -->
      <div
        aria-label="Carousel slide selection"
        class="flex flex-wrap items-center gap-2"
        role="tablist"
      >
        {slides.map((slide, index) => (
            <button
              type="button"
              role="tab"
              id={`carousel-tab-${index}`}
              class={`carousel-tab inline-flex items-center gap-2 rounded px-3 py-1.5 text-xs font-mono transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] ${
                index === 0
                  ? "border border-[var(--primary)] bg-[var(--primary-container)] text-[var(--primary)] font-bold shadow-sm"
                  : "border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-hover)]"
              }`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`slide-${index + 1}`}
              data-target-index={index}
            >
              <span class="h-1.5 w-1.5 rounded-full bg-current" />
              <span>
                {index + 1}.{" "}
                {slide.id === "modern-websites"
                  ? "Websites"
                  : slide.id === "web-apps"
                    ? "Web Apps"
                    : "AI Automations"}
              </span>
            </button>
          ))}
      </div>

      <!-- Arrow Buttons & Pause/Play Control -->
      <div class="flex items-center gap-2">
        <button
          aria-label="Pause automatic slide rotation"
          class="inline-flex h-10 w-10 items-center justify-center rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
          id="carousel-pause-play"
          title="Pause automatic slide rotation"
          type="button"
        >
          <!-- Pause Icon -->
          <svg
            aria-hidden="true"
            class="h-4 w-4"
            fill="currentColor"
            id="pause-icon"
            viewBox="0 0 24 24"
          >
            <path
              clip-rule="evenodd"
              d="M6.75 5.25a.75.75 0 0 1 .75.75v12a.75.75 0 0 1-1.5 0v-12a.75.75 0 0 1 .75-.75Zm10.5 0a.75.75 0 0 1 .75.75v12a.75.75 0 0 1-1.5 0v-12a.75.75 0 0 1 .75-.75Z"
              fill-rule="evenodd"
            ></path>
          </svg>
          <!-- Play Icon -->
          <svg
            aria-hidden="true"
            class="hidden h-4 w-4"
            fill="currentColor"
            id="play-icon"
            viewBox="0 0 24 24"
          >
            <path
              clip-rule="evenodd"
              d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z"
              fill-rule="evenodd"
            ></path>
          </svg>
        </button>

        <button
          aria-label="Previous slide"
          class="inline-flex h-10 w-10 items-center justify-center rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
          id="carousel-prev"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M15 19l-7-7 7-7"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            ></path>
          </svg>
        </button>

        <button
          aria-label="Next slide"
          class="inline-flex h-10 w-10 items-center justify-center rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
          id="carousel-next"
          type="button"
        >
          <ChevronRightIcon aria-hidden="true" class="h-4 w-4" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initCarousel() {
    const carousel = document.getElementById("hero-carousel");
    if (!carousel) {
      return;
    }

    const slides = Array.from(
      carousel.querySelectorAll<HTMLElement>(".hero-slide")
    );
    const tabs = Array.from(
      carousel.querySelectorAll<HTMLElement>(".carousel-tab")
    );
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    const pausePlayBtn = document.getElementById("carousel-pause-play");
    const pauseIcon = document.getElementById("pause-icon");
    const playIcon = document.getElementById("play-icon");

    let currentIndex = 0;
    let autoPlayInterval: number | null = null;
    let isPlaying = true;
    const intervalTime = 6000;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) {
      isPlaying = false;
      updatePausePlayButton();
    }

    function goToSlide(newIndex: number) {
      if (newIndex === currentIndex) {
        return;
      }

      // Handle cyclic index
      if (newIndex < 0) {
        newIndex = slides.length - 1;
      } else if (newIndex >= slides.length) {
        newIndex = 0;
      }

      // Hide current slide
      const currentSlide = slides[currentIndex];
      currentSlide.classList.remove("relative", "opacity-100", "z-10");
      currentSlide.classList.add(
        "absolute",
        "inset-0",
        "opacity-0",
        "pointer-events-none",
        "z-0"
      );

      const currentTab = tabs[currentIndex];
      currentTab.setAttribute("aria-selected", "false");
      currentTab.className =
        "carousel-tab inline-flex items-center gap-2 rounded px-3 py-1.5 text-xs font-mono transition-all border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-hover)]";

      // Show new slide
      const nextSlide = slides[newIndex];
      nextSlide.classList.remove(
        "absolute",
        "inset-0",
        "opacity-0",
        "pointer-events-none",
        "z-0"
      );
      nextSlide.classList.add("relative", "opacity-100", "z-10");

      const nextTab = tabs[newIndex];
      nextTab.setAttribute("aria-selected", "true");
      nextTab.className =
        "carousel-tab inline-flex items-center gap-2 rounded px-3 py-1.5 text-xs font-mono transition-all border border-[var(--primary)] bg-[var(--primary-container)] text-[var(--primary)] font-bold shadow-sm";

      currentIndex = newIndex;
    }

    function startAutoPlay() {
      if (prefersReducedMotion || !isPlaying) {
        return;
      }
      stopAutoPlay();
      autoPlayInterval = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, intervalTime);
    }

    function stopAutoPlay() {
      if (autoPlayInterval !== null) {
        clearInterval(autoPlayInterval);
        autoPlayInterval = null;
      }
    }

    function updatePausePlayButton() {
      if (isPlaying) {
        pauseIcon?.classList.remove("hidden");
        playIcon?.classList.add("hidden");
        pausePlayBtn?.setAttribute(
          "aria-label",
          "Pause automatic slide rotation"
        );
        pausePlayBtn?.setAttribute("title", "Pause automatic slide rotation");
      } else {
        pauseIcon?.classList.add("hidden");
        playIcon?.classList.remove("hidden");
        pausePlayBtn?.setAttribute(
          "aria-label",
          "Start automatic slide rotation"
        );
        pausePlayBtn?.setAttribute("title", "Start automatic slide rotation");
      }
    }

    prevBtn?.addEventListener("click", () => {
      goToSlide(currentIndex - 1);
      if (isPlaying) {
        startAutoPlay();
      }
    });

    nextBtn?.addEventListener("click", () => {
      goToSlide(currentIndex + 1);
      if (isPlaying) {
        startAutoPlay();
      }
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        goToSlide(i);
        if (isPlaying) {
          startAutoPlay();
        }
      });
    });

    pausePlayBtn?.addEventListener("click", () => {
      isPlaying = !isPlaying;
      if (isPlaying) {
        startAutoPlay();
      } else {
        stopAutoPlay();
      }
      updatePausePlayButton();
    });

    // Pause on hover & on keyboard focus within carousel for WCAG compliance
    carousel.addEventListener("mouseenter", stopAutoPlay);
    carousel.addEventListener("mouseleave", () => {
      if (isPlaying) {
        startAutoPlay();
      }
    });
    carousel.addEventListener("focusin", stopAutoPlay);
    carousel.addEventListener("focusout", () => {
      if (isPlaying) {
        startAutoPlay();
      }
    });

    // Keyboard navigation (Arrow keys, Home, End)
    carousel.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        goToSlide(currentIndex - 1);
        tabs[currentIndex]?.focus();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        goToSlide(currentIndex + 1);
        tabs[currentIndex]?.focus();
      } else if (e.key === "Home") {
        e.preventDefault();
        goToSlide(0);
        tabs[0]?.focus();
      } else if (e.key === "End") {
        e.preventDefault();
        goToSlide(slides.length - 1);
        tabs[slides.length - 1]?.focus();
      }
    });

    startAutoPlay();
  }

  initCarousel();
  document.addEventListener("astro:after-swap", initCarousel);
</script>
